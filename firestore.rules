rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NOTE: These rules are permissive because the admin panel currently uses
    // client-side Firebase SDK without Firebase Auth. This is temporary.
    // TODO: Migrate admin operations to backend + use Firebase Auth with custom claims.
    // Products: anyone can read, writes allowed (temporary)
    match /products/{productId} {
      allow read: if true;
      allow write: if true; // TODO: restrict to authenticated admin via custom claim
    }
    // Categories: admin writes (temporary open)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true; // TODO: restrict to authenticated admin via custom claim
    }
    // Orders: public create, admin read/update (temporary open)
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if true; // TODO: restrict to authenticated admin via custom claim
    }
  }
}
